# Byte-compiled / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments / secrets (never commit endpoint URLs or keys)
.venv/
venv/
.env
.env.*
*.local

# Model weights
*.pt
*.bin
*.safetensors
models/
scratch_models/

# Bulk / private data must NEVER be committed to this public repo.
# It intentionally ships only curated public subsets:
#   examples/sample_images/  (40 privacy-reviewed demo images)
#   data/gold_images/        (500 unchanged privacy-reviewed evaluation-gold images)
#   data/research_images/    (500 additional individually reviewed, unlabelled originals)
#   data/image_pool/         (combined checksums and anonymous source-byte aliases)
#   results/**/*summary*.json + the aggregate retrieval summary
# Do not add unblurred images, the full gold records, or per-image result dumps.
/data/images/
/data/gold/
/data/annotations/
/runs/
/outputs/

# OS / editor
.DS_Store
.idea/
.vscode/

# ConstructionSite-10k images are gated (CC BY-NC); fetched locally, never committed.
/examples/public_images/
# Local run outputs of run_rcasr.py / run_demo.py
/results/demo_rcasr/
/results/demo/

# Author-side review records and release archives stay outside the public package.
/release-review/
/review_private*.json
/review_freeze/
/final_contact_sheets/
/final_blur_region_sheets/
*.zip

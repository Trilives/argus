#   examples/sample_images/  (20 privacy-reviewed demo images)
#   results/**/*summary*.json + the aggregate retrieval summary
# Do not add the full image pool, gold annotations, or per-image result dumps.
/data/images/
/data/gold/
/data/annotations/
/runs/
/outputs/

